// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  role                  String                 @default("USER")
  isTwoFactorEnabled    Boolean                @default(false)
  twoFactorConfirmation TwoFactorConfirmation?

  // 🆕 Current organization preference
  currentOrganizationId String?

  accounts      Account[]
  organizations OrganizationMembership[]
  reminders     Reminder[]

  Organization Organization[]

  // Project management relations
  managedProjects     Project[]         @relation("ProjectManager")
  tempManagedProjects Project[]         @relation("TempProjectManager")
  createdTemplates    ProjectTemplate[] @relation("TemplateCreator")

  // Budget management relations
  budgetApprovals   BudgetRevision[] @relation("BudgetApprover")
  budgetResolutions BudgetAlert[]    @relation("BudgetResolver")

  // 🆕 Cost transfer relations
  createdTransfers  CostTransfer[] @relation("TransferCreator")
  approvedTransfers CostTransfer[] @relation("TransferApprover")

  // Journal relations
  postedJournals   Journal[] @relation("PostedByUser")
  reversedJournals Journal[] @relation("ReversedByUser")

  // Invoice relations
  createdInvoices  Invoice[] @relation("InvoiceCreator")
  approvedInvoices Invoice[] @relation("InvoiceApprover")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model TwoFactorConfirmation {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reminder {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  dueDate     DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id             String  @id @default(cuid())
  name           String
  description    String?
  businessDomain String  @default("OTHER")

  // Business information (migrated from Company)
  address    String?
  city       String?
  postalCode String?
  country    String? @default("Canada")
  phone      String?
  email      String?
  website    String?

  // Canadian tax information
  taxNumber     String? // Business Number (BN)
  nasNumber     String? // NAS (Numéro d'assurance sociale)
  gstNumber     String? // GST/HST Registration Number
  qstNumber     String? // QST Registration Number (Quebec)
  fiscalYearEnd String? // Fiscal year end (date format: YYYY-MM-DD)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members   OrganizationMembership[]
  projects  Project[]
  customers Customer[]
  vendors   Vendor[]

  // Project management relations
  activities       Activity[]
  subActivities    SubActivity[]
  projectTemplates ProjectTemplate[]

  // Budget management relations
  budgets         Budget[]
  budgetRevisions BudgetRevision[]
  budgetAlerts    BudgetAlert[]

  // Invoice management relations
  invoices        Invoice[]
  invoiceLines    InvoiceLine[]
  invoicePayments InvoicePayment[]

  // Accounting relations
  chartAccounts  ChartAccount[]
  taxCodes       TaxCode[]
  journals       Journal[]
  journalLines   JournalLine[]
  costCategories CostCategory[]

  // 🆕 Project-specific cost group management
  costTransfers CostTransfer[]

  @@unique([ownerId, name])
}

model OrganizationMembership {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  role           String    @default("MEMBER")
  isActive       Boolean   @default(true)
  joinedAt       DateTime  @default(now())
  lastActiveAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
}

model Project {
  id                   String    @id @default(cuid())
  organizationId       String
  code                 String
  name                 String
  description          String?
  executionAddress     String?
  projectDomain        String?
  clientId             String?
  managerId            String?
  tempManagerId        String?
  tempManagerEnd       DateTime?
  kind                 String    @default("BILLABLE")
  status               String    @default("ACTIVE")
  totalBudget          Decimal?
  totalBudgetCosting   Decimal? // Total Budget coûtant (coûts bruts connus à l'interne)
  totalBudgetSelling   Decimal? // Total Budget vendant (budget remis au client)
  initialProfitDollars Decimal? // Profit initial (dollars) = budget vendant - budget coûtant
  initialProfitPercent Decimal? // Profit initial (%)
  currency             String    @default("CAD")
  startDate            DateTime?
  endDate              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Customer?    @relation(fields: [clientId], references: [id])
  manager      User?        @relation("ProjectManager", fields: [managerId], references: [id])
  tempManager  User?        @relation("TempProjectManager", fields: [tempManagerId], references: [id])

  // Project structure relations
  activities    Activity[]
  subActivities SubActivity[]

  // Budget management relations
  budgets Budget[]

  // Invoice management relations
  invoices     Invoice[]
  invoiceLines InvoiceLine[]

  // Accounting relations
  journalLines JournalLine[]

  // 🆕 Project-specific cost group configuration
  costGroupCodes ProjectCostGroupCode[]

  // 🆕 Cost transfer relations
  sourceTransfers CostTransfer[] @relation("SourceTransfers")
  targetTransfers CostTransfer[] @relation("TargetTransfers")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([clientId])
  @@index([managerId])
}

// Project Activities (Phases/Tasks within projects)
model Activity {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  code           String // Activity code (e.g., "01010", "01135", "01220")
  name           String
  description    String?
  budgetAmount   Decimal? @db.Decimal(15, 2)
  costToDate     Decimal? @default(0) @db.Decimal(15, 2)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)

  // 5-group budget breakdown
  budgetM   Decimal? @default(0) @db.Decimal(15, 2) // Matériel
  budgetS   Decimal? @default(0) @db.Decimal(15, 2) // Sous-traitance
  budgetD   Decimal? @default(0) @db.Decimal(15, 2) // Divers
  budgetE   Decimal? @default(0) @db.Decimal(15, 2) // Équipement
  budgetMOD Decimal? @default(0) @db.Decimal(15, 2) // Main-d'œuvre

  // Actual costs by group (calculated from journal entries)
  actualM   Decimal? @default(0) @db.Decimal(15, 2)
  actualS   Decimal? @default(0) @db.Decimal(15, 2)
  actualD   Decimal? @default(0) @db.Decimal(15, 2)
  actualE   Decimal? @default(0) @db.Decimal(15, 2)
  actualMOD Decimal? @default(0) @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subActivities SubActivity[]
  budgets       Budget[]
  invoiceLines  InvoiceLine[]
  journalLines  JournalLine[]
  costGroups    ActivityCostGroup[] // 🆕 Multi-group support

  // 🆕 Cost transfer relations
  sourceActivityTransfers CostTransfer[] @relation("SourceActivityTransfers")
  targetActivityTransfers CostTransfer[] @relation("TargetActivityTransfers")

  @@unique([projectId, code])
  @@index([organizationId])
  @@index([projectId])
  @@index([isActive])
}

// Sub-Activities (Detailed breakdown of activities)
model SubActivity {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  activityId     String
  code           String // Sub-activity code (e.g., "01010-01", "01010-02")
  name           String
  description    String?
  budgetAmount   Decimal? @db.Decimal(15, 2)
  costToDate     Decimal? @default(0) @db.Decimal(15, 2)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)

  // 5-group budget breakdown
  budgetM   Decimal? @default(0) @db.Decimal(15, 2)
  budgetS   Decimal? @default(0) @db.Decimal(15, 2)
  budgetD   Decimal? @default(0) @db.Decimal(15, 2)
  budgetE   Decimal? @default(0) @db.Decimal(15, 2)
  budgetMOD Decimal? @default(0) @db.Decimal(15, 2)

  // Actual costs by group
  actualM   Decimal? @default(0) @db.Decimal(15, 2)
  actualS   Decimal? @default(0) @db.Decimal(15, 2)
  actualD   Decimal? @default(0) @db.Decimal(15, 2)
  actualE   Decimal? @default(0) @db.Decimal(15, 2)
  actualMOD Decimal? @default(0) @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity     Activity               @relation(fields: [activityId], references: [id], onDelete: Cascade)
  budgets      Budget[]
  invoiceLines InvoiceLine[]
  journalLines JournalLine[]
  costGroups   SubActivityCostGroup[] // 🆕 Multi-group support

  @@unique([activityId, code])
  @@index([organizationId])
  @@index([projectId])
  @@index([activityId])
  @@index([isActive])
}

// Project Templates (Reusable project structures)
model ProjectTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  category       String? // e.g., "Construction", "Renovation", "Maintenance"
  industry       String? // e.g., "Residential", "Commercial", "Industrial"
  totalBudget    Decimal? @db.Decimal(15, 2)
  currency       String   @default("CAD")
  isActive       Boolean  @default(true)
  isPublic       Boolean  @default(false) // Public templates available to all orgs
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateActivities    TemplateActivity[]
  templateSubActivities TemplateSubActivity[]
  createdBy             User?                 @relation("TemplateCreator", fields: [createdById], references: [id])
  createdById           String?

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([category])
  @@index([industry])
  @@index([isActive])
  @@index([isPublic])
}

// Template Activities (Predefined activities in templates)
model TemplateActivity {
  id           String   @id @default(cuid())
  templateId   String
  code         String // Activity code (e.g., "01010", "01135", "01220")
  name         String
  description  String?
  budgetAmount Decimal? @db.Decimal(15, 2)

  // 5-Group Budget Breakdown
  budgetM   Decimal? @db.Decimal(15, 2) // Matériel
  budgetS   Decimal? @db.Decimal(15, 2) // Sous-traitance
  budgetD   Decimal? @db.Decimal(15, 2) // Divers
  budgetE   Decimal? @db.Decimal(15, 2) // Équipement
  budgetMOD Decimal? @db.Decimal(15, 2) // Main-d'œuvre

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  template              ProjectTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateSubActivities TemplateSubActivity[]

  @@unique([templateId, code])
  @@index([templateId])
  @@index([isActive])
  @@index([sortOrder])
}

// Template Sub-Activities (Predefined sub-activities in templates)
model TemplateSubActivity {
  id           String   @id @default(cuid())
  templateId   String
  activityId   String
  code         String // Sub-activity code (e.g., "01010-01", "01010-02")
  name         String
  description  String?
  budgetAmount Decimal? @db.Decimal(15, 2)

  // 5-Group Budget Breakdown
  budgetM   Decimal? @db.Decimal(15, 2) // Matériel
  budgetS   Decimal? @db.Decimal(15, 2) // Sous-traitance
  budgetD   Decimal? @db.Decimal(15, 2) // Divers
  budgetE   Decimal? @db.Decimal(15, 2) // Équipement
  budgetMOD Decimal? @db.Decimal(15, 2) // Main-d'œuvre

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  template ProjectTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  activity TemplateActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, code])
  @@index([templateId])
  @@index([activityId])
  @@index([isActive])
  @@index([sortOrder])
}

model Customer {
  id                  String   @id @default(cuid())
  organizationId      String
  name                String
  email               String?
  phone               String?
  address             String?
  city                String?
  postalCode          String?
  country             String?  @default("Canada")
  receivableAccountId String? // Link to Chart of Accounts
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receivableAccount ChartAccount? @relation("CustomerReceivableAccount", fields: [receivableAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  projects          Project[]
  invoices          Invoice[]
  journalLines      JournalLine[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Vendor {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  email            String?
  phone            String?
  address          String?
  city             String?
  postalCode       String?
  country          String?  @default("Canada")
  payableAccountId String? // Link to Chart of Accounts
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payableAccount ChartAccount? @relation("VendorPayableAccount", fields: [payableAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  invoices       Invoice[]
  journalLines   JournalLine[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@index([email])
  @@index([token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@index([email])
  @@index([token])
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@index([email])
  @@index([token])
}

// Canadian Chart of Accounts (NCECF Compliant)
model ChartAccount {
  id                       String   @id @default(cuid())
  organizationId           String
  number                   String // Account number (e.g., "1000", "2000")
  name                     String // Account name (e.g., "Cash", "Accounts Payable")
  type                     String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE, TAX
  description              String?
  isActive                 Boolean  @default(true)
  isSystem                 Boolean  @default(false) // System accounts can't be deleted
  allowManualEntries       Boolean  @default(true)
  requireProjectAllocation Boolean  @default(false)
  defaultTaxCodeId         String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultTaxCode TaxCode?     @relation(fields: [defaultTaxCodeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Usage tracking
  journalLines JournalLine[]

  // Customer/Vendor relations
  customerReceivables Customer[] @relation("CustomerReceivableAccount")
  vendorPayables      Vendor[]   @relation("VendorPayableAccount")

  // 🆕 Cost group relations
  activityCostGroups    ActivityCostGroup[]
  subActivityCostGroups SubActivityCostGroup[]
  projectCostGroupCodes ProjectCostGroupCode[]

  // Invoice relations
  invoiceRevenueAccounts InvoiceLine[] @relation("InvoiceRevenueAccount")

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([type])
}

// Tax Codes for Canadian taxes (GST/HST, QST, etc.)
model TaxCode {
  id             String   @id @default(cuid())
  organizationId String
  name           String // "GST 5%", "QST 9.975%", "HST 13%"
  code           String // "GST", "QST", "HST"
  rate           Decimal  @db.Decimal(5, 4) // Tax rate (e.g., 0.05 for 5%)
  province       String? // Province for HST rates
  isActive       Boolean  @default(true)
  isCompound     Boolean  @default(false) // For compound taxes like QST on GST
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chartAccounts ChartAccount[]
  invoiceLines  InvoiceLine[]
  journalLines  JournalLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
}

// Journal for all accounting entries
model Journal {
  id             String    @id @default(cuid())
  organizationId String
  journalType    String // "PURCHASE", "SALES", "CASH_RECEIPTS", "CASH_DISBURSEMENTS", "GENERAL"
  entryDate      DateTime
  reference      String? // Journal reference number
  description    String
  totalAmount    Decimal   @db.Decimal(12, 2) // Total debit amount (should equal total credit)
  status         String    @default("DRAFT") // "DRAFT", "POSTED", "REVERSED"
  postedAt       DateTime?
  postedBy       String?
  reversedAt     DateTime?
  reversedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          JournalLine[]
  postedByUser   User?         @relation("PostedByUser", fields: [postedBy], references: [id])
  reversedByUser User?         @relation("ReversedByUser", fields: [reversedBy], references: [id])

  @@index([organizationId])
  @@index([journalType])
  @@index([entryDate])
  @@index([status])
  @@map("journals")
}

model JournalLine {
  id             String   @id @default(cuid())
  journalId      String
  organizationId String
  accountId      String
  projectId      String?
  activityId     String?
  subActivityId  String?
  costGroup      String? // M, S, D, E, MOD for 5-group system (legacy - single group)
  costGroups     Json? // 🆕 Multi-group support: [{"group": "M", "amount": 500}, {"group": "MOD", "amount": 300}]
  description    String
  debitAmount    Decimal? @db.Decimal(12, 2)
  creditAmount   Decimal? @db.Decimal(12, 2)
  taxCodeId      String?
  reference      String? // Reference number (invoice, PO, etc.)

  // 🆕 Cost transfer support
  transferType      String? // "INTER_PROJECT", "INTER_ACTIVITY", "INTER_SUB_ACTIVITY"
  transferSourceId  String? // ID source pour transferts
  transferTargetId  String? // ID cible pour transferts
  transferReference String? // Reference du transfert

  entryDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  journal      Journal      @relation(fields: [journalId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      ChartAccount @relation(fields: [accountId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  activity     Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  subActivity  SubActivity? @relation(fields: [subActivityId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  taxCode      TaxCode?     @relation(fields: [taxCodeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Invoice and payment relations
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vendor         Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoicePayment InvoicePayment? @relation(fields: [invoicePaymentId], references: [id], onDelete: SetNull)

  // Foreign keys for the new relations
  customerId       String?
  vendorId         String?
  invoiceId        String?
  invoicePaymentId String?

  @@index([journalId])
  @@index([organizationId])
  @@index([accountId])
  @@index([projectId])
  @@index([activityId])
  @@index([subActivityId])
  @@index([entryDate])
  @@index([costGroup])
  // 🆕 New indexes for enhanced functionality
  @@index([transferType])
  @@index([transferReference])
  @@map("journal_lines")
}

// 5-Group Cost Category System for Canadian Project Accounting
// M = Matériel & Fournitures
// S = Sous-traitance & Services externes  
// D = Frais généraux & Divers
// E = Équipement & Immobilisations
// MOD = Main-d'œuvre & Charges sociales
model CostCategory {
  id             String   @id @default(cuid())
  organizationId String
  code           String // M, S, D, E, MOD
  name           String
  description    String
  color          String   @default("#6B7280")
  icon           String? // Optional icon for UI
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
}

// Budget Management System
model Budget {
  id             String  @id @default(cuid())
  organizationId String
  projectId      String
  activityId     String?
  subActivityId  String?

  // Budget Details
  name         String
  description  String?
  budgetAmount Decimal @db.Decimal(15, 2)
  currency     String  @default("CAD")

  // 5-Group Budget Breakdown
  budgetM   Decimal? @db.Decimal(15, 2) // Matériel
  budgetS   Decimal? @db.Decimal(15, 2) // Sous-traitance
  budgetD   Decimal? @db.Decimal(15, 2) // Divers
  budgetE   Decimal? @db.Decimal(15, 2) // Équipement
  budgetMOD Decimal? @db.Decimal(15, 2) // Main-d'œuvre

  // Actual vs Budget
  actualAmount Decimal @default(0) @db.Decimal(15, 2)
  actualM      Decimal @default(0) @db.Decimal(15, 2)
  actualS      Decimal @default(0) @db.Decimal(15, 2)
  actualD      Decimal @default(0) @db.Decimal(15, 2)
  actualE      Decimal @default(0) @db.Decimal(15, 2)
  actualMOD    Decimal @default(0) @db.Decimal(15, 2)

  // Budget Status
  status   String  @default("ACTIVE") // ACTIVE, REVISED, CLOSED
  isActive Boolean @default(true)

  // Dates
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity     Activity?        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  subActivity  SubActivity?     @relation(fields: [subActivityId], references: [id], onDelete: Cascade)
  revisions    BudgetRevision[]
  alerts       BudgetAlert[]

  @@unique([organizationId, projectId, activityId, subActivityId])
  @@index([organizationId])
  @@index([projectId])
  @@index([activityId])
  @@index([subActivityId])
  @@index([status])
  @@index([isActive])
}

// Budget Revisions for tracking changes
model BudgetRevision {
  id             String @id @default(cuid())
  organizationId String
  budgetId       String

  // Revision Details
  revisionNumber Int
  reason         String
  description    String?

  // Previous Budget Values
  previousBudgetAmount Decimal  @db.Decimal(15, 2)
  previousBudgetM      Decimal? @db.Decimal(15, 2)
  previousBudgetS      Decimal? @db.Decimal(15, 2)
  previousBudgetD      Decimal? @db.Decimal(15, 2)
  previousBudgetE      Decimal? @db.Decimal(15, 2)
  previousBudgetMOD    Decimal? @db.Decimal(15, 2)

  // New Budget Values
  newBudgetAmount Decimal  @db.Decimal(15, 2)
  newBudgetM      Decimal? @db.Decimal(15, 2)
  newBudgetS      Decimal? @db.Decimal(15, 2)
  newBudgetD      Decimal? @db.Decimal(15, 2)
  newBudgetE      Decimal? @db.Decimal(15, 2)
  newBudgetMOD    Decimal? @db.Decimal(15, 2)

  // Change Amounts
  changeAmount Decimal  @db.Decimal(15, 2)
  changeM      Decimal? @db.Decimal(15, 2)
  changeS      Decimal? @db.Decimal(15, 2)
  changeD      Decimal? @db.Decimal(15, 2)
  changeE      Decimal? @db.Decimal(15, 2)
  changeMOD    Decimal? @db.Decimal(15, 2)

  // Approval
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budget       Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  approver     User?        @relation("BudgetApprover", fields: [approvedBy], references: [id])

  @@unique([organizationId, budgetId, revisionNumber])
  @@index([organizationId])
  @@index([budgetId])
  @@index([status])
  @@index([createdAt])
}

// Budget Alerts for overruns and warnings
model BudgetAlert {
  id             String @id @default(cuid())
  organizationId String
  budgetId       String

  // Alert Details
  type     String // OVERRUN, WARNING, APPROACHING_LIMIT
  severity String // LOW, MEDIUM, HIGH, CRITICAL
  title    String
  message  String

  // Thresholds
  threshold     Decimal? @db.Decimal(5, 2) // Percentage threshold (e.g., 80.00 for 80%)
  currentAmount Decimal  @db.Decimal(15, 2)
  budgetAmount  Decimal  @db.Decimal(15, 2)
  percentage    Decimal  @db.Decimal(5, 2) // Current percentage of budget used

  // Alert Status
  isActive   Boolean   @default(true)
  isRead     Boolean   @default(false)
  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budget       Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  resolver     User?        @relation("BudgetResolver", fields: [resolvedBy], references: [id])

  @@index([organizationId])
  @@index([budgetId])
  @@index([type])
  @@index([severity])
  @@index([isActive])
  @@index([isRead])
  @@index([createdAt])
}

// Invoice Management System
model Invoice {
  id             String @id @default(cuid())
  organizationId String

  // Invoice Details
  number  String // Invoice number (auto-generated or manual)
  type    String // SALES, PURCHASE
  status  String    @default("DRAFT") // DRAFT, SENT, PAID, CANCELLED, OVERDUE
  date    DateTime
  dueDate DateTime?

  // References
  ref      String? // External reference
  poNumber String? // Purchase Order number

  // Parties
  customerId String?
  vendorId   String?
  projectId  String?

  // Financial
  subtotal   Decimal @default(0) @db.Decimal(15, 2)
  taxAmount  Decimal @default(0) @db.Decimal(15, 2)
  total      Decimal @default(0) @db.Decimal(15, 2)
  paidAmount Decimal @default(0) @db.Decimal(15, 2)
  currency   String  @default("CAD")

  // Payment Terms
  paymentTerms    String?
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal? @db.Decimal(15, 2)

  // Metadata
  notes         String?
  internalNotes String?
  isActive      Boolean @default(true)

  // Audit trail
  createdBy  String?
  approvedBy String?
  postedAt   DateTime?
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id])
  vendor       Vendor?          @relation(fields: [vendorId], references: [id])
  project      Project?         @relation(fields: [projectId], references: [id])
  lines        InvoiceLine[]
  payments     InvoicePayment[]
  journalLines JournalLine[]

  // User relations
  creator  User? @relation("InvoiceCreator", fields: [createdBy], references: [id])
  approver User? @relation("InvoiceApprover", fields: [approvedBy], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([customerId])
  @@index([vendorId])
  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([date])
  @@index([dueDate])
}

// Invoice Line Items
model InvoiceLine {
  id             String @id @default(cuid())
  organizationId String
  invoiceId      String

  // Line Details
  description String
  quantity    Decimal @db.Decimal(15, 4)
  unitPrice   Decimal @db.Decimal(15, 4)
  amount      Decimal @db.Decimal(15, 2)

  // Tax Information
  taxCodeId   String?
  taxRate     Decimal? @db.Decimal(5, 4)
  taxAmount   Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount Decimal  @db.Decimal(15, 2)

  // Project Tracking
  projectId     String?
  activityId    String?
  subActivityId String?

  // Cost Category (5-Group System)
  costCategory String? // M, S, D, E, MOD

  // GL Account mapping (for automatic journal entry generation)
  revenueAccountId String? // Which GL account to credit for revenue

  // Metadata
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taxCode        TaxCode?      @relation(fields: [taxCodeId], references: [id])
  project        Project?      @relation(fields: [projectId], references: [id])
  activity       Activity?     @relation(fields: [activityId], references: [id])
  subActivity    SubActivity?  @relation(fields: [subActivityId], references: [id])
  revenueAccount ChartAccount? @relation("InvoiceRevenueAccount", fields: [revenueAccountId], references: [id])

  @@index([organizationId])
  @@index([invoiceId])
  @@index([projectId])
  @@index([activityId])
  @@index([subActivityId])
  @@index([costCategory])
  @@index([sortOrder])
}

// Invoice Payments
model InvoicePayment {
  id             String @id @default(cuid())
  organizationId String
  invoiceId      String

  // Payment Details
  amount        Decimal  @db.Decimal(15, 2)
  paymentDate   DateTime
  paymentMethod String? // CASH, CHECK, TRANSFER, CARD, etc.
  reference     String? // Check number, transfer reference, etc.

  // Banking
  bankAccountId String?

  // Metadata
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]

  @@index([organizationId])
  @@index([invoiceId])
  @@index([paymentDate])
}

// 🆕 Multi-Group Cost Management for Activities
model ActivityCostGroup {
  id          String   @id @default(cuid())
  activityId  String
  costGroup   String // M, S, D, E, MOD
  percentage  Decimal  @db.Decimal(5, 2) // Pourcentage de répartition (0-100)
  glAccountId String? // Compte GL spécifique pour ce groupe
  isActive    Boolean  @default(true)
  description String? // Description de l'affectation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  activity  Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  glAccount ChartAccount? @relation(fields: [glAccountId], references: [id])

  @@unique([activityId, costGroup])
  @@index([activityId])
  @@index([costGroup])
  @@index([isActive])
}

// 🆕 Multi-Group Cost Management for Sub-Activities
model SubActivityCostGroup {
  id            String   @id @default(cuid())
  subActivityId String
  costGroup     String // M, S, D, E, MOD
  percentage    Decimal  @db.Decimal(5, 2) // Pourcentage de répartition (0-100)
  glAccountId   String? // Compte GL spécifique pour ce groupe
  isActive      Boolean  @default(true)
  description   String? // Description de l'affectation
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  subActivity SubActivity   @relation(fields: [subActivityId], references: [id], onDelete: Cascade)
  glAccount   ChartAccount? @relation(fields: [glAccountId], references: [id])

  @@unique([subActivityId, costGroup])
  @@index([subActivityId])
  @@index([costGroup])
  @@index([isActive])
}

// 🆕 Cost Transfer System
model CostTransfer {
  id             String @id @default(cuid())
  organizationId String

  // Source
  sourceType          String // PROJECT, ACTIVITY, SUB_ACTIVITY
  sourceProjectId     String?
  sourceActivityId    String?
  sourceSubActivityId String?

  // Target
  targetType          String // PROJECT, ACTIVITY, SUB_ACTIVITY
  targetProjectId     String?
  targetActivityId    String?
  targetSubActivityId String?

  // Transfer Details
  amount      Decimal @db.Decimal(15, 2)
  costGroups  Json // Array: [{"group": "M", "amount": 500}, {"group": "MOD", "amount": 300}]
  description String
  reference   String? // Reference number

  // Approval Workflow
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED, POSTED
  approvalRequired Boolean   @default(false)
  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String?

  // Accounting
  journalReference String? // Reference to journal entries created
  postedAt         DateTime?

  // Metadata
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceProject  Project?     @relation("SourceTransfers", fields: [sourceProjectId], references: [id])
  targetProject  Project?     @relation("TargetTransfers", fields: [targetProjectId], references: [id])
  sourceActivity Activity?    @relation("SourceActivityTransfers", fields: [sourceActivityId], references: [id])
  targetActivity Activity?    @relation("TargetActivityTransfers", fields: [targetActivityId], references: [id])
  creator        User         @relation("TransferCreator", fields: [createdBy], references: [id])
  approver       User?        @relation("TransferApprover", fields: [approvedBy], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([sourceProjectId])
  @@index([targetProjectId])
}

// 🆕 Project-Specific Cost Group Code Assignments
model ProjectCostGroupCode {
  id          String   @id @default(cuid())
  projectId   String
  costGroup   String // M, S, D, E, MOD
  glAccountId String // Code GL assigné pour ce groupe dans ce projet
  description String? // Description de l'assignation (ex: "Matériel - Chantier ABC")
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false) // Si c'est le code par défaut pour ce groupe
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  glAccount ChartAccount @relation(fields: [glAccountId], references: [id])

  @@unique([projectId, costGroup, glAccountId])
  @@index([projectId])
  @@index([costGroup])
  @@index([isActive])
  @@index([isDefault])
}
